# --- 环境模板：复制为 .env 后填入真实值 -------------------------------------
# .env 已被 .gitignore 忽略，切勿提交真实密钥。

# DeepSeek（OpenAI 兼容协议）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 对话模型：deepseek-chat（稳定） / deepseek-v4-flash（低成本，抽取阶段够用）
GRAPHRAG_LLM_MODEL=deepseek-chat

# 向量模型：中文场景用 BAAI/bge-small-zh-v1.5（512 维，ONNX，约 95MB）
GRAPHRAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# HuggingFace 直连不通时改走镜像
HF_ENDPOINT=https://hf-mirror.com

# 检索与融合
GRAPHRAG_TOP_K=12
GRAPHRAG_GRAPH_HOPS=3
GRAPHRAG_CHANNEL_FLOOR=1
GRAPHRAG_LEXICAL_MODE=bigram
GRAPHRAG_WEIGHTS=lexical:1.0,dense:1.0,graph:1.2,community:0.6

# 抽取并发（DeepSeek 侧限流时调小）
GRAPHRAG_WORKERS=6
