# ──────────────────────────────────────────────────────────────
# ds-vision — 项目层 .gitignore（Layer 3）
# 层次模型：~/.gitignore_global < quest-mvp-lab/.gitignore < 本文件
# 若日后独立成仓，需把共享层的通用模式并入本文件
# ──────────────────────────────────────────────────────────────

# 密钥 / 凭证（绝不入库）
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# 运行日志（临时）
*.log

# 测试临时文件
*.tmp
