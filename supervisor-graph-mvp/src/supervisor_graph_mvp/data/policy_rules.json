{
  "ruleset": "数据外发分级管控策略",
  "version": "2026.09",
  "level_order": ["P1", "P2", "P3", "P4"],
  "level_labels": {
    "P1": "公开",
    "P2": "内部",
    "P3": "敏感",
    "P4": "核心"
  },
  "decision_precedence": ["block", "review", "allow"],
  "rules": [
    {
      "id": "R-01",
      "name": "公开数据外发放行",
      "decision": "allow",
      "threshold_level": "P1",
      "owner": "数据安全组",
      "when": [{"op": "level_lte", "value": "P1"}]
    },
    {
      "id": "R-02",
      "name": "内部数据外发需部门审批",
      "decision": "review",
      "threshold_level": "P2",
      "owner": "部门负责人",
      "when": [
        {"op": "level_gte", "value": "P2"},
        {"op": "destination_type_eq", "value": "external"}
      ]
    },
    {
      "id": "R-03",
      "name": "个人信息经协作通道外发需安全组审批",
      "decision": "review",
      "threshold_level": "P3",
      "owner": "数据安全组",
      "when": [
        {"op": "level_gte", "value": "P3"},
        {"op": "channel_in", "value": ["webmail", "im", "cloud-drive"]}
      ]
    },
    {
      "id": "R-04",
      "name": "核心数据禁止外发",
      "decision": "block",
      "threshold_level": "P4",
      "owner": "数据安全组",
      "when": [
        {"op": "level_gte", "value": "P4"},
        {"op": "destination_type_eq", "value": "external"}
      ]
    },
    {
      "id": "R-05",
      "name": "源码与密钥外发需研发负责人审批",
      "decision": "review",
      "threshold_level": "P3",
      "owner": "研发负责人",
      "when": [{"op": "detector_hit", "value": "source_code"}]
    },
    {
      "id": "R-06",
      "name": "分级证据缺失时按次高风险处理",
      "decision": "review",
      "threshold_level": "P2",
      "owner": "数据安全组",
      "when": [{"op": "level_unknown"}]
    }
  ]
}
