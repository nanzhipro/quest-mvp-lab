# ──────────────────────────────────────────────────────────────
# react-loop-mvp — 项目层忽略规则（Layer 3）
# 层次模型：全局 ~/.gitignore_global < quest-mvp-lab/.gitignore < 本文件
# 本文件需自给自足：若日后独立成仓，把共享层的通用模式并入此处即可。
# ──────────────────────────────────────────────────────────────

# Python 构建/缓存产物（可用 uv / pip 重建，一律不入库）
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 运行产物：每次运行独立时间戳目录（证据留痕，但不入库）
runs/

# 本地密钥（本项目的密钥只走环境变量，拒绝任何落盘副本）
.env
api_key
